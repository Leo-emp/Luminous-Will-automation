# ============================================================
# LUMINOUS WILL - Environment Variables
# Copy this file to .env and fill in your API keys
# ============================================================

# ----------------------------------------------------------
# REQUIRED — the pipeline will not run without these
# ----------------------------------------------------------

# ElevenLabs: text-to-speech voiceover generation
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
# Free tier gives ~10,000 characters/month — enough for ~5 short videos
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Pexels: free stock video footage for visual clips
# Get your free API key from: https://www.pexels.com/api/
# No usage limits on the free tier
PEXELS_API_KEY=your_pexels_api_key_here

# Gemini: AI script generation (used for both short and long formats)
# Get your API key from: https://aistudio.google.com/app/apikey
# Free tier gives 15 requests/minute — plenty for video generation
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------
# OPTIONAL — pipeline works without these, enables extras
# ----------------------------------------------------------

# Pixabay: additional stock footage source (fallback if Pexels runs low)
# Get your free API key from: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Freesound: sound effects library (not currently used in core pipeline)
# Get your free API key from: https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# ----------------------------------------------------------
# PREMIUM STOCK SOURCES (optional — higher quality footage/music)
# ----------------------------------------------------------

# Storyblocks: premium stock footage + music library
# Requires paid subscription at https://www.storyblocks.com/
STORYBLOCKS_API_KEY=
STORYBLOCKS_API_SECRET=

# Epidemic Sound: premium music library (future integration slot)
# https://www.epidemicsound.com/
EPIDEMIC_SOUND_API_KEY=

# ----------------------------------------------------------
# AI IMAGE GENERATION (optional — for quote reels)
# ----------------------------------------------------------

# fal.ai: AI image generation for quote reel scene-integrated images
# Sign up at https://fal.ai — pricing ~$0.01-0.04 per image
# Required for AI-generated quote images (subway billboards, 3D letters, etc.)
FAL_KEY=

# ----------------------------------------------------------
# CLOUD STORAGE (optional — for video upload after generation)
# ----------------------------------------------------------

# Vercel Blob: cloud storage for generated videos, thumbnails, and queue
# Get your token from Vercel dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=

# ----------------------------------------------------------
# SOCIAL MEDIA POSTING (optional — for auto-posting pipeline)
# ----------------------------------------------------------

# TikTok: auto-posting generated videos
# Create a developer app at: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram/Facebook: auto-posting via Meta Graph API
# Create a developer app at: https://developers.facebook.com/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ----------------------------------------------------------
# SCHEDULING (optional — customize generation schedule)
# ----------------------------------------------------------

# Schedule overrides for automated generation (cron-driven)
# Long-form default: "monday,thursday" (2x per week)
# Short-form default: "daily"
# Reels default: "daily"
# SCHEDULE_LONG_FORM=monday,thursday
# SCHEDULE_SHORT_FORM=daily
# SCHEDULE_REELS=daily

# ----------------------------------------------------------
# MONITORING (optional — admin notifications)
# ----------------------------------------------------------

# Webhook URL for admin alerts (pipeline failures, quota warnings)
# Can be a Slack webhook, Discord webhook, or any POST endpoint
ALERT_WEBHOOK_URL=

# ----------------------------------------------------------
# DEPLOYMENT — only needed when running on HuggingFace Spaces
# ----------------------------------------------------------

# SPACE_ID: set automatically by HuggingFace Spaces runtime
# When present, output/temp/music dirs redirect to /tmp
# Do NOT set this locally — it's only for cloud deployment
# SPACE_ID=your-username/your-space-name
